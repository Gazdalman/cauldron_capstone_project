@inject UserService UserService
@inject UserSessionState UserSession
@inject RegistrationDto RegisterDto
@inject LogInResult LogInResult

<div>
  <div>
    <h3>@(IsLoginMode ? "Welcome Back": "Create Account")</h3>

    @if (IsLoginMode)
    {
      <input @bind="loginCredential" placeholder="Enter your email or username" />
      <input @bind="loginPassword" type="password" placeholder="Enter your password" />
      <button @onclick="HandleLogin">Log In</button>

      <p>Don't have an account? <a @onclick="() => IsLoginMode = false">Create one</a>.</p>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
      <div class="error-banner">@errorMessage</div>
    }
  </div>
</div>

@code {
  [Parameter] public bool IsLoginMode { get; set; }
  [Parameter] public EventCallback OnClose { get; set; }

  private string loginCredential = "";
  private string loginPassword = "";

  private string errorMessage = "";

  private async Task HandleLogin()
  {
    LogInResult loginResult = await UserService.LogInUserAsync(loginCredential, loginPassword);

    if (loginResult != null)
    {
      UserSession.Login(loginResult.UserId, loginResult.UserName);
      await OnClose.InvokeAsync();
    } else
    {
      errorMessage = "Invalid credential or password";
    }
  }
}

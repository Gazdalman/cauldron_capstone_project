@page "/"
@using Cauldron.Shared.Modals
@inject UserSessionState UserSessionState
<PageTitle>Cauldron - Dashboard</PageTitle>

<div class="dashboard">
  <div class="dashboard-card">
    <h1>Cauldron Kitchen</h1>
    <p>Plan hearty meals and keep every treasured recipe close at hand.</p>
    <div class="dashboard-actions">
      @if (UserSessionState.IsLoggedIn)
      {
        <a href="/recipes/new">Create New Recipe</a>
      }
      else
      {
        <button type="button" @onclick="OpenLogin">Login to create recipe</button>
      }
      <a href="/recipes">Browse Recipes</a>
    </div>
  </div>
</div>

<Modal IsOpen="IsModalOpen" OnClose="CloseModal">
  @if (currView == ModalView.Login)
  {
    <LoginModal OnSuccess="CloseModal" OnSwitch="() => currView = ModalView.Register" />
  }
  else
  {
    <RegistrationModal OnSuccess="CloseModal" OnSwitch="() => currView = ModalView.Login" />
  }
</Modal>

@code {
  private enum ModalView { Login, Register }
  private bool IsModalOpen;
  private ModalView currView = ModalView.Login;

  private void OpenLogin()
  {
    currView = ModalView.Login;
    IsModalOpen = true;
  }

  private void CloseModal()
  {
    IsModalOpen = false;
  }
}

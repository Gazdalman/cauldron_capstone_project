<div class="ingredient-section">
  <div class="ingredient-rows">
    @foreach (var (ingredient, index) in ingredients.Select((ingredient, index) => (ingredient, index)))
    {
      var moveClass = index == movedRowIndex
        ? (moveDirection < 0 ? "row-moved-up" : "row-moved-down")
        : string.Empty;

      <div id="ingredient-row-@(index + 1)" class="ingredient-row @moveClass">
        <span class="ingredient-row-number">@(index + 1).</span>

        <label for="ingredient-amount-@(index + 1)" class="sr-only">Amount</label>
        <input id="ingredient-amount-@(index + 1)"
          type="text"
          class="ingredient-input ingredient-amount"
          placeholder="Amount"
          value="@ingredient.Amount"
          @oninput="e => OnAmountChange(index, e.Value?.ToString())" />

        <label for="ingredient-unit-@(index + 1)" class="sr-only">Unit</label>
        <select id="ingredient-unit-@(index + 1)"
                class="ingredient-select ingredient-unit"
                value="@ingredient.Unit"
                @onchange="e => OnUnitChange(index, e.Value?.ToString())">
          <option value="">Unit...</option>
          @foreach (var unit in units)
          {
            <option value="@unit">@unit</option>
          }
        </select>

        <label for="ingredient-name-@(index + 1)" class="sr-only">Ingredient Name</label>
        <input id="ingredient-name-@(index + 1)"
               type="text"
               class="ingredient-input ingredient-name"
               placeholder="Ingredient Name"
               value="@ingredient.Ingredient"
               @oninput="e => OnIngredientChange(index, e.Value?.ToString())" />

        @if (ingredients.Count > 1)
        {
          <div class="ingredient-row-actions">
            <button type="button"
                    class="row-btn row-btn-remove"
                    aria-label="Remove ingredient @(index + 1)"
                    @onclick="() => RemoveRow(index)">
              X
            </button>

            <button type="button"
                    class="row-btn row-btn-move"
                    disabled="@(index == 0)"
                    aria-label="Move ingredient @(index + 1) up"
                    @onclick="() => MoveRow(-1, index)">
              Up
            </button>

            <button type="button"
                    class="row-btn row-btn-move"
                    disabled="@(index == ingredients.Count - 1)"
                    aria-label="Move ingredient @(index + 1) down"
                    @onclick="() => MoveRow(1, index)">
              Down
            </button>
          </div>
        }
      </div>
    }
  </div>

  <button type="button"
          id="add-ingredient-row-btn"
          class="add-row-btn"
          @onclick="AddRow">
    Add Row
  </button>
</div>
@code {
  private List<IngredientRow> ingredients = new() { new() };
  public sealed record IngredientSubmission(string Quantity, string Name);
  private int? movedRowIndex;
  private int moveDirection;

  private readonly List<string> units = new()
  {
    "g", "kg", "oz", "fl oz","lb", "ml", "l",
    "tsp", "tbsp", "cup", "whole", "clove", "slice", "can", "pinch", "head", "leaf"
  };

  private class IngredientRow
  {
    public string Amount { get; set; } = string.Empty;
    public string Unit { get; set; } = string.Empty;
    public string Ingredient { get; set; } = string.Empty;
  }

  private void OnAmountChange(int index, string? val)
  {
    ingredients[index].Amount = val ?? string.Empty;
  }

  private void OnUnitChange(int index, string? val)
  {
    ingredients[index].Unit = val ?? string.Empty;
  }

  private void OnIngredientChange(int index, string? val)
  {
    ingredients[index].Ingredient = val ?? string.Empty;
  }
  private void AddRow()
  {
    ingredients.Add(new());
  }

  private void RemoveRow(int index)
  {
    ingredients.RemoveAt(index);
  }

  private async void MoveRow(int dir, int index)
  {
    if (dir < 0 )
    {
      (ingredients[index - 1], ingredients[index]) = (ingredients[index], ingredients[index - 1]);
      await TriggerMoveAnimation(index - 1, -1);
    }
    else if (dir > 0)
    {
      (ingredients[index + 1], ingredients[index]) = (ingredients[index], ingredients[index + 1]);
      await TriggerMoveAnimation(index + 1, 1);
    }
  }

  private async Task TriggerMoveAnimation(int targetIndex, int dir)
  {
    movedRowIndex = targetIndex;
    moveDirection = dir;
    StateHasChanged();

    await Task.Delay(220);

    if (movedRowIndex == targetIndex)
    {
      movedRowIndex = null;
      StateHasChanged();
    }
  }

  public bool HasIncompleteRows()
  {
    return ingredients.Any(i =>
    {
      if (ingredients.Count < 1)
      {
        return true;
      }
      bool hasAmount = !string.IsNullOrWhiteSpace(i.Amount);
      bool hasUnit = !string.IsNullOrWhiteSpace(i.Unit);
      bool hasIngredient = !string.IsNullOrWhiteSpace(i.Ingredient);

      bool anyFilled = hasAmount || hasUnit || hasIngredient;
      bool completeEnough = hasAmount && hasIngredient; // Unit optional, or require hasUnit too if desired

      return anyFilled && !completeEnough;
    });
  }

  public List<RecipeIngredient> GetIngredients()
  {
    return ingredients
      .Where(i => !string.IsNullOrWhiteSpace(i.Amount)
                || !string.IsNullOrWhiteSpace(i.Unit)
                || !string.IsNullOrWhiteSpace(i.Ingredient))
      .Select(i =>
      {
        var amount = i.Amount?.Trim() ?? string.Empty;
        var unit = i.Unit?.Trim() ?? string.Empty;
        var quantity = string.Join(" ", new[] { amount, unit }.Where(s => !string.IsNullOrWhiteSpace(s)));
        var name = i.Ingredient?.Trim() ?? string.Empty;

        return new RecipeIngredient
        {
          Quantity = quantity,
          Ingredient = name
        };
      })
      .ToList();
  }
}

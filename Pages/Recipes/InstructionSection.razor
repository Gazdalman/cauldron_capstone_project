<div class="instruction-section">
  <div class="instruction-rows">
    @foreach (var (step, index) in steps.Select((step, index) => (step, index)))
    {
      var moveClass = index == movedRowIndex
        ? (moveDirection < 0 ? "row-moved-up" : "row-moved-down")
        : string.Empty;

      <div id="instruction-row-@(index + 1)" class="instruction-row @moveClass">
        <span class="instruction-step-label">Step @(index + 1):</span>

        <label for="instruction-step-@(index + 1)" class="sr-only">Step @(index + 1) instructions</label>
        <input id="instruction-step-@(index + 1)"
               type="text"
               class="instruction-input"
               placeholder="Describe this step..."
               value="@steps[index]"
               @oninput="e => OnChange(index, e.Value?.ToString())" />

        @if (steps.Count > 1)
        {
          <div class="instruction-row-actions">
            <button type="button"
                    class="row-btn row-btn-remove"
                    aria-label="Remove step @(index + 1)"
                    @onclick="() => RemoveRow(index)">
              X
            </button>

            <button type="button"
                    class="row-btn row-btn-move"
                    disabled="@(index == 0)"
                    aria-label="Move step @(index + 1) up"
                    @onclick="() => MoveRow(-1, index)">
              Up
            </button>

            <button type="button"
                    class="row-btn row-btn-move"
                    disabled="@(index == steps.Count - 1)"
                    aria-label="Move step @(index + 1) down"
                    @onclick="() => MoveRow(1, index)">
              Down
            </button>
          </div>
        }
      </div>
    }
  </div>

  <button type="button"
          id="add-instruction-row-btn"
          class="add-row-btn"
          @onclick="AddRow">
    Add Row
  </button>
</div>

@code {
  private List<string> steps = new() { string.Empty };
  private int? movedRowIndex;
  private int moveDirection;

  private void OnChange(int index, string? val)
  {
    steps[index] = val ?? string.Empty;
  }

  private void AddRow()
  {
    steps.Add(string.Empty);
  }

  private void RemoveRow(int index)
  {
    steps.RemoveAt(index);
  }

  private async Task MoveRow(int dir, int index)
  {
    if (dir < 0)
    {
      (steps[index - 1], steps[index]) = (steps[index], steps[index - 1]);
      await TriggerMoveAnimation(index - 1, -1);
    }
    else
    {
      (steps[index + 1], steps[index]) = (steps[index], steps[index + 1]);
      await TriggerMoveAnimation(index + 1, 1);
    }
  }

  private async Task TriggerMoveAnimation(int targetIndex, int dir)
  {
    movedRowIndex = targetIndex;
    moveDirection = dir;
    StateHasChanged();

    await Task.Delay(220);

    if (movedRowIndex == targetIndex)
    {
      movedRowIndex = null;
      StateHasChanged();
    }
  }

  public bool HasSteps()
{
  return steps.Any(s => !string.IsNullOrWhiteSpace(s));
}
  public string GetInstructions()
{
  return string.Join("; ", steps
    .Select(s => s?.Trim() ?? string.Empty)
    .Where(s => !string.IsNullOrWhiteSpace(s)));
}
}

@using System.ComponentModel
<div>
  @foreach (var (step, index) in steps.Select((step, index) => (step, index)))
  {
    <div>
      Step @(index + 1):
      <input
      value="@steps[index]"
      @oninput="e => OnChange(index, e.Value?.ToString())"/>
      @if (steps.Count > 1)
      {
        <button @onclick="() => RemoveRow(index)">X</button>
        @if (index > 0)
        {
          <button
          @onclick="() => MoveRow(-1, index)">Up</button>

        }
        if (index != steps.Count - 1)
        {
          <button
          @onclick="() => MoveRow(1, index)">Down</button>
        }
      }

    </div>
  }
    <button @onclick="AddRow">Add Row</button>

</div>

@code {
  private List<string> steps = new() {string.Empty };

  private void OnChange(int index, string val)
  {
    steps[index] = val;
  }
  private void AddRow()
  {
    steps.Add(string.Empty);
  }

  private void RemoveRow(int index)
  {
    steps.RemoveAt(index);
  }

  private void MoveRow(int dir, int index)
  {
    string val;
    if (dir < 0)
    {
      val = steps[index - 1];
      steps[index-1] = steps[index];
      steps[index] = val;
    }
    else
    {
      val = steps[index + 1];
      steps[index + 1] = steps[index];
      steps[index] = val;
    }
  }
}

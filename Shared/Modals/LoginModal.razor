@inject UserService UserService
@inject UserSessionState UserSessionState

  <div class="login-form">
    <h2>"Welcome Back"</h2>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
      <div class="error-banner">@errorMessage</div>
    }

    <div class="form-group">
      <label>Credential</label>
      <input @bind="loginCredential" placeholder="Enter your email or username" />
    </div>

    <div class="form-group">
      <label>Password</label>
      <input @bind="loginPassword" type="password" placeholder="Enter your password" />
    </div>

    <button @onclick="HandleLogin">Log In</button>

    <p class="modal-switch">Don't have an account? <a @onclick="OnRegister">Create one</a>.</p>
</div>

@code {
  [Parameter] public EventCallback OnSuccess { get; set; }
  [Parameter] public EventCallback OnRegister { get; set; }

  private string loginCredential = "";
  private string loginPassword = "";

  private string errorMessage = "";

  private async Task HandleLogin()
  {
    LogInResult loginResult = await UserService.LogInUserAsync(loginCredential, loginPassword);

    if (loginResult != null)
    {
      UserSessionState.Login(loginResult.UserId, loginResult.UserName);
      await OnSuccess.InvokeAsync();
    } else
    {
      errorMessage = "Invalid credential or password";
    }
  }
}

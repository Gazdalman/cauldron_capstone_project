
@inject UserService UserService
@inject UserSessionState UserSessionState

<div class="registration-form">
  <h2>Create Account</h2>
  <EditForm OnValidSubmit="HandleRegister" Model="dto">
    <DataAnnotationsValidator />

    <div class="form-group">
      @if (result.Errors.ContainsKey("UserName"))
    {
      <div class="error-banner">@result.Errors["UserName"]</div>
    }
      <ValidationMessage For="@(() => dto.UserName)" />
      <label>Username</label>
      <InputText @bind-Value="dto.UserName"
      class="@(result.Errors.ContainsKey("UserName") ? "input-error" : "")"
      placeholder="Enter username" />
    </div>

    <div class="form-group">
      @if (result.Errors.ContainsKey("Email"))
    {
      <div class="error-banner">@result.Errors["Email"]</div>
    }
      <ValidationMessage For="@(() => dto.Email)" />
      <label>Email</label>
      <InputText @bind-Value="dto.Email"
      class="@(result.Errors.ContainsKey("Email") ? "input-error" : "")"
      type="email" placeholder="Enter email" />
    </div>

    <div class="form-group">
      <ValidationMessage For="@(() => dto.Password)" />
      <label>Password</label>
      <InputText @bind-Value="dto.Password" type="password" placeholder="Enter password" />
    </div>

    <button type="submit">Register</button>
</EditForm>

  <p class="modal-switch">Already have an account? <a @onclick="OnSwitch">Log In</a>.</p>
</div>

@code
{
  [Parameter] public EventCallback OnSuccess { get; set; }
  [Parameter] public EventCallback OnSwitch { get; set; }

  private RegistrationDto dto = new RegistrationDto();
  private RegistrationResult result = new RegistrationResult();

  private string loginCredential = "";
  private string loginPassword = "";

  private async Task HandleRegister()
  {
    result = await UserService.RegisterUserAsync(dto);
    if (result.Succeeded)
    {
      LogInResult user = await UserService.LogInUserAsync(dto.UserName, dto.Password);
      if (user != null)
      {
        UserSessionState.Login(user.UserId, user.UserName);
      }
      await OnSuccess.InvokeAsync();
    }
  }
}

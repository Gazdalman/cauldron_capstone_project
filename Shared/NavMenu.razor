@inject UserSessionState UserSessionState
<nav>
  <h3>Cauldron</h3>
  <div>
    @if (UserSessionState.IsLoggedIn)
    {
      <span>Welcome, @UserSessionState.CurrentUserName!</span>
      <button @onclick="UserSessionState.Logout">Log Out</button>
    } else
    {
      <button @onclick="() => OpenModal(true)">Log In</button>
    }
  </div>
</nav>

@if (isModalOpen)
{
    <AuthModal IsLoginMode="isLoginMode" OnClose="CloseModal" />
}

@code {
    private bool isModalOpen = false;
    private bool isLoginMode = true;

    private void OpenModal(bool loginMode)
    {
        isLoginMode = loginMode;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }
}

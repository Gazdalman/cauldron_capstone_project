@using Cauldron.Shared.Modals
@inject UserSessionState UserSessionState
<nav>
  <h3>Cauldron</h3>
  <div>
    @if (UserSessionState.IsLoggedIn)
    {
      <span>Welcome, @UserSessionState.CurrentUserName!</span>
      <button @onclick="UserSessionState.Logout">Log Out</button>
    } else
    {
      <button @onclick="OpenLogin">Log In</button>
    }
  </div>
</nav>

<Modal IsOpen="IsModalOpen" OnClose="CloseModal">
  @if (currView == ModalView.Login)
  {
    <LoginModal
      OnSuccess="CloseModal"
      OnRegister="() => currView = ModalView.Register" />
  }
  </Modal>

@code {
  private enum ModalView { Login, Register}
  private bool IsModalOpen = false;
  private ModalView currView = ModalView.Login;

  private void OpenLogin()
  {
    currView = ModalView.Login;
    IsModalOpen = true;
  }

  private void CloseModal()
  {
    IsModalOpen = false;
  }
}
